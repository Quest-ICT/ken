[Unit]
Description=Ken nightly snapshot (compressed plaintext, 0600)

[Service]
Type=oneshot
User=ken
Group=ken
# /opt/ken, NOT /opt/ken/current. The installer used to write the `current` symlink
# here, and BACKUP_DIR derives from KEN_HOME — which put the backups directory behind a
# symlink and made the pre-upgrade prune silently delete nothing for two releases, since
# `find` does not descend into a symlinked starting point. The prune carries `-H` now and
# works either way; this stays unsymlinked because a path that only works because of a
# flag somewhere else is a trap waiting for the next reader.
Environment=KEN_HOME=/opt/ken
Environment=KEN_DB=/opt/ken/data/ken.db
# THIS UNIT PRODUCES PLAINTEXT, AND NOTHING HERE CAN CHANGE THAT. Its Description said
# "encrypted" and this comment recommended setting an age recipient — for a control 2.0.0
# retired. `scripts/ken-snapshot-lib.sh` states it plainly: "IT NO LONGER ENCRYPTS."
# Setting KEN_AGE_RECIPIENT logs a NOTE and writes the plaintext anyway; the old warning
# that the step "fails closed and keeps NO snapshot" was false in the other direction too —
# the snapshot is written and kept.
#
# If these files leave the box, encrypt them in whatever moves them. Litestream can encrypt
# the continuous replica (the age: block in configs/litestream.yml); that is Litestream's
# feature, it is a different tier, and it does not cover this snapshot. See docs/BACKUP.md.
ExecStart=/opt/ken/scripts/ken-snapshot.sh
# A snapshot is a full copy of the database. Create it 0600 from the FIRST byte: the
# securing step chmods it, but that lands only AFTER `VACUUM INTO` has written the whole
# file, so under systemd's default 0022 umask a multi-GB dump would sit world-readable
# for the length of the dump — and, in a setgid backups dir, already carrying the backup
# group. An explicit chmod 0640 later still applies when KEN_BACKUP_GROUP is set.
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/ken/data /opt/ken/backups
